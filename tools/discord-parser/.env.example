# Discord credentials (never commit the real .env)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Only members with at least one of these role IDs are treated as clan members
DISCORD_MEMBER_ROLE_IDS=526133207339368459,827554967103340585

# Optional tuning
DISCORD_API_VERSION=10
DISCORD_MEMBER_PAGE_SIZE=1000
DISCORD_CACHE_PATH=./cache/discord.sqlite
DISCORD_MEMBERS_OUTPUT=./output/discord-members.json
